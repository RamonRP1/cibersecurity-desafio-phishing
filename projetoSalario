<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Organizador Financeiro</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
          
            background: linear-gradient(to bottom, #f0f4f8, #d9e9f1), 
                        url('imagens/financas1.jpg') no-repeat center center fixed;
            background-size: cover;
            color: #333;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: auto;
        }
        .container {
            background: rgba(255, 255, 255, 0.9);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 500px;
            text-align: center;
        }
        h1 {
            color: #388E3C;
            margin-bottom: 20px;
            font-size: 2rem;
        }
        label {
            display: block;
            margin-bottom: 10px;
            font-weight: bold;
            color: #555;
        }
        input {
            width: 100%;
            padding: 12px;
            margin-bottom: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 1rem;
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #388E3C;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            transition: background-color 0.3s;
        }
        button:hover {
            background-color: #2E7D32;
        }
        .result {
            margin-top: 20px;
            padding: 20px;
            background: #E8F5E9;
            border-radius: 8px;
            line-height: 1.6;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        table, th, td {
            border: 1px solid #ddd;
        }
        th, td {
            padding: 12px;
            text-align: left;
            font-size: 1rem;
        }
        th {
            background-color: #388E3C;
            color: white;
        }
        .quote {
            margin-top: 20px;
            font-style: italic;
            color: #555;
            text-align: center;
        }
        .footer {
            margin-top: 20px;
            font-size: 0.9rem;
            color: #666;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Organizador Financeiro</h1>
        <label for="salary">Informe seu salário:</label>
        <input type="number" id="salary" placeholder="Ex: 3000" />
        <button onclick="calculateBudget()">Calcular</button>
        <div class="result" id="result"></div>
        <div class="quote">
            <p>"A riqueza, como uma árvore, cresce a partir de uma simples semente. A primeira moeda de cobre que economizar será a semente a partir da qual sua árvore da riqueza crescerá. Quanto mais cedo plantá-la, mais cedo a árvore crescerá. E quanto mais fielmente alimentar e regar essa árvore com economias constantes, logo chegará o dia em que poderá abrigar-se em pleno contentamento embaixo de sua sombra." - Benjamin Franklin</p>
        </div>
        <div class="footer">
            <p>"Poupar é o caminho para a liberdade financeira." - Desconhecido</p>
        </div>
    </div>

    <script>
        function calculateBudget() {
            const salaryInput = document.getElementById('salary').value;
            const salary = parseFloat(salaryInput);

            if (isNaN(salary) || salary <= 0) {
                alert('Por favor, insira um valor válido para o salário.');
                return;
            }

            const emergencyFund = salary * 0.10;
            const remaining = salary - emergencyFund;

            const budget = {
                "Reserva de Emergência": emergencyFund.toFixed(2),
                "Alimentação": (remaining * 0.40).toFixed(2),
                "Contas a Pagar": (remaining * 0.30).toFixed(2),
                "Viagens/Passeios": (remaining * 0.10).toFixed(2),
                "Lazer": (remaining * 0.10).toFixed(2),
            };

            let resultHTML = '<h3>Distribuição do Salário:</h3>';
            resultHTML += '<table>';
            resultHTML += '<tr><th>Categoria</th><th>Valor (R$)</th></tr>';
            for (const [key, value] of Object.entries(budget)) {
                resultHTML += `<tr><td>${key}</td><td>${value}</td></tr>`;
            }
            resultHTML += '</table>';

            document.getElementById('result').innerHTML = resultHTML;
        }
    </script>
</body>
</html>
